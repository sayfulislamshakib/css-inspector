{
  "manifest_version": 3,
  "name": "CSS Inspector",
  "version": "1.0",
  "description": "Inspect web page elements and extract CSS properties.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "action": {
    "default_title": "Toggle CSS Inspector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle CSS Inspector"
    },
    "toggle_pause_on_popup": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Toggle Pause Inspector When Popup is Open"
    },
    "toggle_block_interactions": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "Toggle Block Website Interactions"
    }
  }
}
